# Secrets -- ne jamais committer
.env

# Reglages d'editeur personnels -- pas destines a la publication
.vscode/

# Python
__pycache__/
*.pyc
*.pyo
evaluation/__pycache__/
.pytest_cache/

# Fichiers de session/debug et sauvegardes volumineuses -- conservés sur
# disque dans archive/, jamais versionnés (régénérables ou obsolètes)
archive/

# Sauvegardes du graphe Neo4j produites par scripts/backup_graph.py et
# scripts/wipe_graph.py (nodes.json/relationships.json, plusieurs Mo) --
# volumineuses et régénérables à tout moment depuis le graphe vivant,
# jamais versionnées (archiver manuellement dans archive/ si besoin de les
# garder, comme pour les sauvegardes des sessions precedentes). Couvre a la
# fois backup_AAAAMMJJ/ et backup_wipe_AAAAMMJJ_HHMMSS/.
backup_*/

# Checkpoint de reprise d'evaluate.py -- transitoire, pas un résultat final
evaluation/resultats_partial.json

# Journal de travail complet -- contient des details de session (incidents,
# contexte personnel) qui ne sont pas destines a la publication. Reste sur
# disque dans docs/JOURNAL_TRAVAIL.md, jamais versionne. Voir
# docs/JOURNAL_PUBLIC.md pour la version publique epuree.
docs/JOURNAL_TRAVAIL.md

# Presentations du laboratoire (documents/*.pptx) et leur extraction texte
# (textes/CHATBOT *.txt) -- diffusion non autorisee, restent uniquement en
# local. Les 6 autres fichiers de textes/ (sources publiques OMS/NHS/CDC/
# Sante publique France) ne sont pas concernes et restent versionnes.
documents/*.pptx
textes/CHATBOT*.txt

# Logs ponctuels générés pendant les runs (build, chatbot, évaluation)
log.txt
log_*.txt
evaluation/log_*.txt

# Residus de compilation LaTeX (poster_tabac.tex) -- regenerables, pas le
# .pdf final (garde volontairement, voir discussion avec l'utilisatrice)
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.synctex.gz
