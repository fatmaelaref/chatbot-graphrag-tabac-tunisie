# Copier ce fichier en ".env" et remplir les valeurs reelles.
# ".env" ne doit jamais etre commite (voir .gitignore).

NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io
NEO4J_USERNAME=<utilisateur>
NEO4J_PASSWORD=<mot_de_passe>
NEO4J_DATABASE=<nom_de_la_base>
GROQ_API_KEY=<cle_groq>

# Optionnel -- utilises par extract_documents.py. Valeurs par defaut si absents
# (installation Windows habituelle de ce poste) : decommente et adapte
# uniquement si Tesseract/LibreOffice sont installes ailleurs ou sur une
# autre plateforme.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
